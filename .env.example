# =====================================================
# SkillLens environment variables
# Copy this file to .env and fill in the values you need.
# Scripts under scripts/ will auto-source .env.
# =====================================================

# --- OpenAI ---
OPENAI_API_KEY=your-api-key-here

# --- Azure OpenAI ---
# Use either an API key OR Managed Identity (set AZURE_CLIENT_ID).
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Conda env name (defaults to skilllens) ---
# SKILLLENS_CONDA_ENV=skilllens

# --- ALFWorld data root (defaults to ~/.cache/alfworld) ---
# ALFWORLD_DATA=/data/alfworld

# --- Optional: override default model for extraction ---
# LLM_MODEL=gpt-4o
